<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/fragment_menu_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/background_app">

	<!-- Windows-style home: header, Start-menu tiles, taskbar. -->
	<LinearLayout
		android:id="@+id/diamond_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="@dimen/_20sdp"
		android:paddingTop="@dimen/_14sdp"
		app:layout_constraintTop_toTopOf="parent">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/diamond_title"
			android:textColor="@color/primary_text"
			android:textSize="26sp"
			android:textStyle="bold" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/diamond_subtitle"
			android:textColor="@color/secondary_text"
			android:textSize="14sp" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:orientation="horizontal"
		android:weightSum="4"
		android:paddingHorizontal="@dimen/_14sdp"
		android:paddingVertical="@dimen/_14sdp"
		app:layout_constraintTop_toBottomOf="@id/diamond_header"
		app:layout_constraintBottom_toTopOf="@id/diamond_taskbar">

		<com.kdt.mcgui.LauncherMenuButton
			android:id="@+id/custom_control_button"
			style="@style/LauncherMenuButton"
			android:layout_width="0dp"
			android:layout_height="@dimen/_72sdp"
			android:layout_weight="1"
			android:layout_margin="@dimen/_4sdp"
			android:text="@string/diamond_controls" />

		<com.kdt.mcgui.LauncherMenuButton
			android:id="@+id/share_logs_button"
			style="@style/LauncherMenuButton"
			android:layout_width="0dp"
			android:layout_height="@dimen/_72sdp"
			android:layout_weight="1"
			android:layout_margin="@dimen/_4sdp"
			android:text="@string/diamond_logs" />

		<com.kdt.mcgui.LauncherMenuButton
			android:id="@+id/bedrock_button"
			style="@style/LauncherMenuButton"
			android:layout_width="0dp"
			android:layout_height="@dimen/_72sdp"
			android:layout_weight="1"
			android:layout_margin="@dimen/_4sdp"
			android:text="@string/diamond_bedrock" />

		<com.kdt.mcgui.LauncherMenuButton
			android:id="@+id/open_files_button"
			style="@style/LauncherMenuButton"
			android:layout_width="0dp"
			android:layout_height="@dimen/_72sdp"
			android:layout_weight="1"
			android:layout_margin="@dimen/_4sdp"
			android:text="@string/diamond_folder" />
	</LinearLayout>

	<!-- The "taskbar": profile picker on the left, PLAY on the right. -->
	<LinearLayout
		android:id="@+id/diamond_taskbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:background="@color/background_bottom_bar"
		android:padding="@dimen/_8sdp"
		app:layout_constraintBottom_toBottomOf="parent">

		<com.kdt.mcgui.mcVersionSpinner
			android:id="@+id/mc_version_spinner"
			android:layout_width="0dp"
			android:layout_height="@dimen/_36sdp"
			android:layout_weight="1"
			android:background="@drawable/win_input_background"
			android:drawableEnd="@drawable/spinner_arrow"
			app:drawableEndPadding="@dimen/_1sdp"
			app:drawableEndSize="@dimen/_12sdp"
			app:drawableStartIntegerScaling="true"
			app:drawableStartSize="@dimen/_24sdp" />

		<ImageButton
			android:id="@+id/edit_profile_button"
			android:layout_width="@dimen/_36sdp"
			android:layout_height="@dimen/_36sdp"
			android:layout_marginStart="@dimen/_6sdp"
			android:background="@drawable/win_input_background"
			android:padding="@dimen/_8sdp"
			android:scaleType="fitCenter"
			android:tint="@android:color/white"
			android:src="@drawable/ic_edit_profile" />

		<com.kdt.mcgui.MineButton
			android:id="@+id/play_button"
			android:layout_width="@dimen/_110sdp"
			android:layout_height="@dimen/_36sdp"
			android:layout_marginStart="@dimen/_8sdp"
			android:text="@string/diamond_play"
			android:textAllCaps="true" />
	</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
