<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/fragment_menu_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/diamond_bg_gradient">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="horizontal"
		android:padding="@dimen/_12sdp"
		android:weightSum="2">

		<!-- Hero card: who we are, which instance, PLAY. -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:background="@drawable/diamond_hero_background"
			android:orientation="vertical"
			android:padding="@dimen/_14sdp">

			<ImageView
				android:layout_width="@dimen/_44sdp"
				android:layout_height="@dimen/_44sdp"
				android:src="@drawable/ic_pojav_full" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				android:text="@string/diamond_title"
				android:textColor="@color/primary_text"
				android:textSize="26sp"
				android:textStyle="bold" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/diamond_subtitle"
				android:textColor="@color/secondary_text"
				android:textSize="14sp" />

			<View
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1" />

			<com.kdt.mcgui.mcVersionSpinner
				android:id="@+id/mc_version_spinner"
				android:layout_width="match_parent"
				android:layout_height="@dimen/_36sdp"
				android:background="@drawable/win_input_background"
				android:drawableEnd="@drawable/spinner_arrow"
				app:drawableEndPadding="@dimen/_1sdp"
				app:drawableEndSize="@dimen/_12sdp"
				app:drawableStartIntegerScaling="true"
				app:drawableStartSize="@dimen/_24sdp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_8sdp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<com.kdt.mcgui.MineButton
					android:id="@+id/play_button"
					android:layout_width="0dp"
					android:layout_height="@dimen/_40sdp"
					android:layout_weight="1"
					android:text="@string/diamond_play"
					android:textAllCaps="true" />

				<ImageButton
					android:id="@+id/edit_profile_button"
					android:layout_width="@dimen/_40sdp"
					android:layout_height="@dimen/_40sdp"
					android:layout_marginStart="@dimen/_8sdp"
					android:background="@drawable/win_input_background"
					android:padding="@dimen/_9sdp"
					android:scaleType="fitCenter"
					android:src="@drawable/ic_edit_profile"
					android:tint="@android:color/white" />
			</LinearLayout>
		</LinearLayout>

		<!-- Tile grid. -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_marginStart="@dimen/_12sdp"
			android:layout_weight="1"
			android:orientation="vertical"
			android:weightSum="3">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:orientation="horizontal"
				android:weightSum="2">

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/custom_control_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_margin="@dimen/_4sdp"
					android:layout_weight="1"
					android:text="@string/diamond_controls" />

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/share_logs_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_margin="@dimen/_4sdp"
					android:layout_weight="1"
					android:text="@string/diamond_logs" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:orientation="horizontal"
				android:weightSum="2">

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/bedrock_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_margin="@dimen/_4sdp"
					android:layout_weight="1"
					android:text="@string/diamond_bedrock" />

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/open_files_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_margin="@dimen/_4sdp"
					android:layout_weight="1"
					android:text="@string/diamond_folder" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:orientation="horizontal"
				android:weightSum="2">

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/alpha_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_margin="@dimen/_4sdp"
					android:layout_weight="1"
					android:text="@string/diamond_alpha" />

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/beta_button"
					style="@style/LauncherMenuButton"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_margin="@dimen/_4sdp"
					android:layout_weight="1"
					android:text="@string/diamond_beta" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
